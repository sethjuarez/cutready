{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "With an unavailable saved harness, switching to Prompty lets a real chat turn run on it. Uses the real credential vault (realVault).",
  "tags": ["@settings", "@harness", "@live"],
  "setup": [
    { "name": "Create fixture with an unavailable harness and the real vault", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/settings-live.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-intro.sk" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "chat turn runs after switching harness",
      "tags": ["@live"],
      "timeoutMs": 90000,
      "description": "Needs a signed-in model connection. agent_chat_with_tools skips frontend IPC telemetry (sensitive), so the backend start log proves which harness ran.",
      "steps": [
        { "expect": { "testId": "activity-settings" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "click": { "testId": "activity-settings" } },
        { "click": { "testId": "settings-tab-ai" } },
        { "click": { "testId": "settings-ai-tab-agent" } },
        { "click": { "testId": "harness-option-prompty" } },
        { "expect": "[data-testid=\"harness-option-prompty\"][data-selected=\"true\"]", "toBeVisible": true },
        { "click": { "testId": "settings-close" } },
        { "click": { "testId": "activity-chat" } },
        { "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "toBeVisible": true, "timeoutMs": 20000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "Reply with the single word READY and nothing else." },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "expectLog": "[agent_chat_with_tools] start", "timeoutMs": 30000 },
        { "expectLog": "engine=prompty agent=" },
        { "expectLog": "engine=drill-unavailable-harness", "not": true }
      ]
    }
  ]
}
