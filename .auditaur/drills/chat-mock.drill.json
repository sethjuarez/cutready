{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "Agent chat against a local mock model (scripts/auditaur-mock-llm.mjs, 127.0.0.1 only): streaming, a tool round trip, cancellation, and provider errors. The dummy key is typed into Settings and lands in the vault; fixture teardown restores the vault byte-for-byte (and setup does so first after a crashed run).",
  "tags": ["@chat", "@settings"],
  "env": { "OPENAI_API_KEY": "drill-dummy-key" },
  "setup": [
    { "name": "Create fixture and start mock model", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/chat-mock.json"] }
  ],
  "teardown": [
    { "name": "Stop mock model, restore the vault, remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-brief.md" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Enter the dummy key for the mock connection", "click": { "testId": "activity-settings" } },
    { "click": { "testId": "settings-scope-app" } },
    { "click": { "testId": "settings-tab-ai" } },
    { "click": { "testId": "settings-ai-tab-connections" } },
    { "expect": "input[placeholder=\"Enter your API key\"]", "toBeVisible": true, "timeoutMs": 15000 },
    { "fill": "input[placeholder=\"Enter your API key\"]", "value": "drill-dummy-key" },
    { "expect": "body", "toContainText": "Key saved", "timeoutMs": 10000 },
    { "click": { "testId": "settings-close" } }
  ],
  "tests": [
    {
      "name": "streams a reply from the mock model",
      "timeoutMs": 120000,
      "steps": [
        { "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "toBeVisible": true, "timeoutMs": 30000 },
        { "name": "model picker shows the mock model", "expectValue": "(() => { const b = document.querySelector('[data-testid=\"secondary-chat-panel\"] button[title^=\"Select Model\"]'); return b ? b.title + ' | ' + b.innerText : 'no model picker'; })()", "toMatch": "drill-mock", "timeoutMs": 15000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "Say hello." },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] [data-testid=\"chat-messages-scroll\"]", "toContainText": "MOCK-REPLY-OK", "timeoutMs": 30000 },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toHaveCount": 0, "timeoutMs": 30000 },
        { "expectLog": "[agent_chat_with_tools] start" },
        { "expectLog": "engine=prompty agent=" },
        { "name": "mock got a streamed request with the dummy key", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-mock-llm", "e.path === '/chat/completions' && e.model === 'drill-mock' && e.stream && e.authorized"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "runs a tool round trip and records the run",
      "timeoutMs": 120000,
      "steps": [
        { "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "toBeVisible": true, "timeoutMs": 30000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "MOCK:read-note brief.md" },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] [data-testid=\"chat-messages-scroll\"]", "toContainText": "MOCK-TOOL-RESULT", "timeoutMs": 45000 },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the note content went back to the model", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-mock-llm", "e.lastRole === 'tool' && e.toolResult?.includes('MOCK-BRIEF-7731')"] },
        { "name": "the mock was offered the agent tools", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-mock-llm", "e.tools?.includes('read_note')"] },
        { "name": "the run is recorded as Prompty OpenAI with a read_note result", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-agent-runs", "--provider", "openai", "--model", "drill-mock", "--engine", "prompty", "--tools", "read_note"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "stops a streaming turn",
      "timeoutMs": 120000,
      "steps": [
        { "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "toBeVisible": true, "timeoutMs": 30000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "MOCK:slow" },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toBeVisible": true, "timeoutMs": 20000, "name": "turn starts" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] [data-testid=\"chat-messages-scroll\"]", "toContainText": "MOCK-SLOW", "timeoutMs": 20000 },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]", "toBeVisible": true, "timeoutMs": 30000, "name": "composer returns to idle" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toHaveCount": 0 },
        { "expectLog": "[agent_chat_with_tools] cancelled" },
        { "name": "the model stream is aborted", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-mock-llm", "e.aborted === true && e.tag === 'slow'"] }
      ]
    },
    {
      "name": "shows a provider error and recovers",
      "fixme": "setChatMessages clears chatError, so the error card never renders (appStore.ts setChatMessages; ChatPanel send catch)",
      "timeoutMs": 150000,
      "steps": [
        { "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "toBeVisible": true, "timeoutMs": 30000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "MOCK:error" },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "name": "error card appears", "expect": { "testId": "secondary-chat-panel" }, "toContainText": "Something went wrong", "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Show details" } },
        { "expect": { "testId": "secondary-chat-panel" }, "toContainText": "MOCK-PROVIDER-ERROR" },
        { "expectLog": "[agent_chat_with_tools] error" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toHaveCount": 0, "timeoutMs": 30000 },
        { "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]", "value": "Say hello again." },
        { "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]" },
        { "expect": "[data-testid=\"secondary-chat-panel\"] [data-testid=\"chat-messages-scroll\"]", "toContainText": "MOCK-REPLY-OK", "timeoutMs": 30000 },
        { "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]", "toHaveCount": 0, "timeoutMs": 30000 }
      ]
    }
  ]
}