{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "App launches into the demo project with a healthy shell.",
  "tags": ["@smoke"],
  "setup": [
    { "name": "Create demo project fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/smoke.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-01-plan-the-demo.sk" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "opens the demo project",
      "steps": [
        { "expect": { "testId": "activity-settings" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "expect": { "text": "Plan the demo" }, "toBeVisible": true },
        { "expect": "body", "not": true, "toContainText": "Something went wrong" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "authored content stays out of telemetry",
      "description": "Opening a sketch reads it over IPC; redactKeys must strip its narrative and actions.",
      "steps": [
        { "click": { "text": "Plan the demo" } },
        { "expect": "body", "toContainText": "editable production plan", "timeoutMs": 15000 },
        { "expectIpc": { "pattern": "^get_sketch$" }, "name": "the sketch was read over instrumented IPC" },
        { "expectNoTelemetry": { "pattern": "editable production plan|scan the planning table" }, "name": "sketch narrative and actions are redacted" }
      ]
    }
  ]
}
