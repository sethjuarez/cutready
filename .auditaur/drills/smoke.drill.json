{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "App launches into the demo project with a healthy shell.",
  "tags": ["@smoke"],
  "setup": [
    { "name": "Create demo project fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/smoke.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "tests": [
    {
      "name": "opens the demo project",
      "steps": [
        { "waitFor": { "testId": "activity-settings" }, "timeoutMs": 45000 },
        { "expect": { "text": "Plan the demo" }, "toBeVisible": true },
        { "expect": "body", "not": true, "toContainText": "Something went wrong" },
        { "expectNoErrors": true }
      ]
    }
  ]
}
