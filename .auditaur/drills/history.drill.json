{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "History tab and Compare: opening History, Timeline and Graph views, the per-document filter, Preview, Compare views for sketches, notes, storyboards and images, Copy ID, and restoring a project or one document. Each test starts from two seeded saves: \"Outline drafted\" then \"Script polished\" (with a comment).",
  "tags": [
    "@history"
  ],
  "env": {
    "GIT_AUTHOR_NAME": "Drill History",
    "GIT_AUTHOR_EMAIL": "history@drill.test"
  },
  "setup": [
    {
      "name": "Create a project with two saves across every document type",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "setup",
        ".auditaur/fixtures/history.json"
      ]
    }
  ],
  "teardown": [
    {
      "name": "Remove fixture",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "teardown"
      ],
      "always": true
    }
  ],
  "beforeEach": [
    {
      "name": "Drop pending autosaves and per-test UI state",
      "clearStorage": true
    },
    {
      "name": "a project is open",
      "expect": {
        "testId": "explorer-import-menu"
      },
      "toBeVisible": true,
      "timeoutMs": 45000
    },
    {
      "name": "Restore the seeded project",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "reset"
      ]
    },
    {
      "name": "Reload the restored project with clean UI state",
      "clearStorage": true
    },
    {
      "expect": {
        "testId": "explorer-item-plan.md"
      },
      "toBeVisible": true,
      "timeoutMs": 45000
    }
  ],
  "tests": [
    {
      "name": "opens History from the status popover and the timeline menu, in both views",
      "steps": [
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "expect": {
            "testId": "history-entry-comment",
            "nth": 0
          },
          "toHaveText": "Tightened the narration for the keynote."
        },
        {
          "expect": {
            "testId": "history-entry-chips",
            "nth": 0
          },
          "toBeVisible": true
        },
        {
          "click": {
            "role": "button",
            "name": "Graph",
            "exact": true,
            "within": {
              "role": "group",
              "name": "History view"
            }
          }
        },
        {
          "expect": ".history-graph-card[aria-current=\"true\"]",
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "role": "button",
            "name": "Timeline",
            "exact": true,
            "within": {
              "role": "group",
              "name": "History view"
            }
          }
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 1
          },
          "toContainText": "Outline drafted"
        },
        {
          "click": {
            "testId": "titlebar-variation"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Open history",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "history-tab"
          },
          "toBeVisible": true
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "filters History to one document from its menu",
      "steps": [
        {
          "click": {
            "testId": "explorer-item-close.sk"
          },
          "button": "right",
          "timeoutMs": 45000
        },
        {
          "click": {
            "role": "menuitem",
            "name": "View history",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "history-document-filter"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry"
          },
          "toHaveCount": 1,
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished"
        },
        {
          "click": {
            "role": "button",
            "name": "Show history for the whole project instead of Closing"
          }
        },
        {
          "expect": {
            "testId": "history-document-filter"
          },
          "toHaveCount": 0
        },
        {
          "expect": {
            "testId": "history-entry"
          },
          "toHaveCount": 2,
          "timeoutMs": 15000
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "compares a version's sketch, note, storyboard and image with the previous one",
      "steps": [
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 0
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Compare with previous",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "compare-tab"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "compare-sides"
          },
          "toContainText": "Outline drafted"
        },
        {
          "click": {
            "role": "button",
            "name": "tour.sk",
            "within": {
              "role": "navigation",
              "name": "Changed documents"
            }
          }
        },
        {
          "expect": "[data-row-status=\"added\"]",
          "toContainText": "Wrap up with pricing."
        },
        {
          "expect": "[data-row-status=\"removed\"]",
          "toContainText": "Show the dashboard."
        },
        {
          "expect": "[data-changed-field=\"narrative\"]",
          "toContainText": "Open the app in one click."
        },
        {
          "click": {
            "role": "button",
            "name": "plan.md",
            "within": {
              "role": "navigation",
              "name": "Changed documents"
            }
          }
        },
        {
          "expect": {
            "role": "button",
            "name": "Inline",
            "exact": true
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "role": "button",
            "name": "Side by side",
            "exact": true
          }
        },
        {
          "expect": "[data-block-status=\"changed\"]",
          "toContainText": "pricing slide"
        },
        {
          "click": {
            "role": "button",
            "name": "keynote.sb",
            "within": {
              "role": "navigation",
              "name": "Changed documents"
            }
          }
        },
        {
          "expect": "[data-entry-status=\"added\"]",
          "toContainText": "close",
          "timeoutMs": 15000
        },
        {
          "click": {
            "role": "button",
            "name": "hero.png",
            "within": {
              "role": "navigation",
              "name": "Changed documents"
            }
          }
        },
        {
          "expect": "img[alt=\"Outline drafted\"]",
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "expect": "img[alt=\"Script polished\"]",
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "expectIpc": "read_version_file_bytes",
          "status": "ok"
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "previews an older version and compares it with now",
      "steps": [
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 1
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Preview",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "restore-version"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "testId": "compare-with-now"
          }
        },
        {
          "expect": {
            "testId": "compare-sides"
          },
          "toContainText": "Outline drafted",
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "compare-sides"
          },
          "toContainText": "Now"
        },
        {
          "click": {
            "role": "button",
            "name": "plan.md",
            "within": {
              "role": "navigation",
              "name": "Changed documents"
            }
          }
        },
        {
          "expect": "[data-block-status=\"changed\"]",
          "toContainText": "pricing slide",
          "timeoutMs": 15000
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "shows unsaved changes at the top and compares a version with them",
      "steps": [
        {
          "click": {
            "testId": "explorer-item-plan.md"
          }
        },
        {
          "click": {
            "label": "Note content"
          }
        },
        {
          "press": "Control+End",
          "target": {
            "label": "Note content"
          }
        },
        {
          "type": {
            "label": "Note content"
          },
          "value": "Thank everyone."
        },
        {
          "expectIpc": "update_note",
          "status": "ok"
        },
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "expect": {
            "testId": "history-unsaved-entry"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 0
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Compare with now",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "compare-sides"
          },
          "toContainText": "Script polished",
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "compare-tab"
          },
          "toContainText": "Thank everyone.",
          "timeoutMs": 15000
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "copies a version's ID",
      "steps": [
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 0
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Copy ID",
            "exact": true
          }
        },
        {
          "expect": {
            "text": "Copied version ID"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "restores the whole project from an older version as a new save",
      "steps": [
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 1
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Restore project",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "restore-version-dialog"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "testId": "restore-confirm"
          }
        },
        {
          "expectIpc": "restore_version_as_new_save",
          "status": "ok",
          "timeoutMs": 30000
        },
        {
          "name": "the note is back",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "plan.md",
            "lacks:pricing slide"
          ]
        },
        {
          "name": "the sketch is back",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "tour.sk",
            "lacks:one click"
          ]
        },
        {
          "name": "the newer sketch is gone",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "close.sk",
            "absent"
          ]
        },
        {
          "name": "saved under the default name",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--format=%s"
          ],
          "stdout": "Restore Outline drafted"
        },
        {
          "name": "as a new save on top of history",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--skip=1",
            "--format=%s"
          ],
          "stdout": "Script polished"
        },
        {
          "expect": {
            "testId": "history-entry"
          },
          "toHaveCount": 3,
          "timeoutMs": 15000
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "saves unsaved work as a version before restoring the project",
      "steps": [
        {
          "click": {
            "testId": "explorer-item-plan.md"
          }
        },
        {
          "click": {
            "label": "Note content"
          }
        },
        {
          "press": "Control+End",
          "target": {
            "label": "Note content"
          }
        },
        {
          "type": {
            "label": "Note content"
          },
          "value": "Thank everyone."
        },
        {
          "expectIpc": "update_note",
          "status": "ok"
        },
        {
          "click": {
            "testId": "titlebar-sync-status"
          }
        },
        {
          "click": {
            "testId": "open-history"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "history-entry",
            "nth": 0
          },
          "toContainText": "Script polished",
          "timeoutMs": 30000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 1
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Restore project",
            "exact": true
          }
        },
        {
          "click": {
            "testId": "restore-confirm"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "testId": "pre-action-dialog"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "fill": {
            "testId": "version-name-input"
          },
          "value": "Thanks added"
        },
        {
          "click": {
            "role": "button",
            "name": "Save version & continue",
            "exact": true
          }
        },
        {
          "expectIpc": "restore_version_as_new_save",
          "status": "ok",
          "timeoutMs": 30000
        },
        {
          "name": "the restore is the newest save",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--format=%s"
          ],
          "stdout": "Restore Outline drafted"
        },
        {
          "name": "on top of the saved work",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--skip=1",
            "--format=%s"
          ],
          "stdout": "Thanks added"
        },
        {
          "name": "which kept the edit",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "grep",
            "-q",
            "Thank everyone.",
            "HEAD~1",
            "--",
            "plan.md"
          ]
        },
        {
          "name": "the workspace has the restored note",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "plan.md",
            "lacks:Thank everyone."
          ]
        },
        {
          "expect": {
            "testId": "history-tab"
          },
          "toBeVisible": true
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "restores one document, then explains there is nothing left to restore",
      "steps": [
        {
          "click": {
            "testId": "explorer-item-plan.md"
          },
          "button": "right",
          "timeoutMs": 45000
        },
        {
          "click": {
            "role": "menuitem",
            "name": "View history",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "history-document-filter"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 1
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Restore plan",
            "exact": true
          }
        },
        {
          "expect": {
            "testId": "restore-version-dialog"
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "click": {
            "testId": "restore-confirm"
          }
        },
        {
          "expectIpc": "restore_version_paths_as_new_save",
          "status": "ok",
          "timeoutMs": 30000
        },
        {
          "name": "the note is back",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "plan.md",
            "lacks:pricing slide"
          ]
        },
        {
          "name": "other documents keep their newer version",
          "run": "node",
          "args": [
            "scripts/auditaur-drill-fixture.mjs",
            "expect-file",
            "tour.sk",
            "one click"
          ]
        },
        {
          "name": "saved under the default name",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--format=%s"
          ],
          "stdout": "Restore Outline drafted"
        },
        {
          "expect": {
            "testId": "history-entry"
          },
          "toHaveCount": 3,
          "timeoutMs": 15000
        },
        {
          "name": "the first restore raised no errors (the second one fails on purpose)",
          "expectNoErrors": true
        },
        {
          "click": {
            "testId": "history-entry-menu",
            "nth": 2
          }
        },
        {
          "click": {
            "role": "menuitem",
            "name": "Restore plan",
            "exact": true
          }
        },
        {
          "click": {
            "testId": "restore-confirm"
          },
          "timeoutMs": 15000
        },
        {
          "expect": {
            "text": "Nothing to restore. These documents already match that version."
          },
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "name": "no extra save",
          "run": "git",
          "cwd": "${CUTREADY_PROJECT}",
          "args": [
            "log",
            "-1",
            "--format=%s"
          ],
          "stdout": "Restore Outline drafted"
        }
      ]
    }
  ]
}
