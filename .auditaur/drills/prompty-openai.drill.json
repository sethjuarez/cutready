{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "Prompty battle drill against direct OpenAI: reading, delegation, cancellation, sketch and storyboard mutation, and visuals. Seeds no keys: configure OpenAI in Settings and make it the default provider first. Durable-state checks run as teardown hooks until Auditaur ships run steps (AR-7).",
  "tags": [
    "@live",
    "@prompty",
    "@openai"
  ],
  "setup": [
    {
      "name": "Create battle fixture",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "setup",
        ".auditaur/fixtures/prompty-openai.json"
      ]
    }
  ],
  "teardown": [
    {
      "name": "Completed runs are Prompty OpenAI and used every tool",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "expect-agent-runs",
        "--provider",
        "openai",
        "--model",
        "gpt-4o",
        "--engine",
        "prompty",
        "--min-completed",
        "3",
        "--tools",
        "read_note,read_sketch,delegate_to_agent,update_planning_row,write_storyboard,set_row_visual,review_row_visual"
      ]
    },
    {
      "name": "Sketch mutation persisted",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "expect-json",
        "openai-battle.sk",
        "JSON.stringify(doc).includes('OPENAI-MUTATION-4242')"
      ]
    },
    {
      "name": "Visual set on a row",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "expect-json",
        "openai-battle.sk",
        "doc.rows.some((row) => row.visual)"
      ]
    },
    {
      "name": "Storyboard mutation persisted",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "expect-json",
        "openai-battle.sb",
        "JSON.stringify(doc).includes('OPENAI-STORYBOARD-4242')"
      ]
    },
    {
      "name": "Remove fixture",
      "run": "node",
      "args": [
        "scripts/auditaur-drill-fixture.mjs",
        "teardown"
      ],
      "always": true
    }
  ],
  "tests": [
    {
      "name": "chat uses OpenAI",
      "steps": [
        {
          "expect": {
            "testId": "activity-chat"
          },
          "toBeVisible": true,
          "timeoutMs": 45000
        },
        {
          "click": {
            "testId": "activity-chat"
          }
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "toBeVisible": true,
          "timeoutMs": 60000
        },
        {
          "evaluate": "(() => { const b = document.querySelector('[data-testid=\"secondary-chat-panel\"] button[title^=\"Select Model\"]'); if (!b || !b.title.includes('OpenAI') || !b.innerText.includes('gpt-4o')) throw new Error('Set OpenAI (gpt-4o) as the default provider before this drill; the picker shows ' + (b ? b.title + ' / ' + b.innerText : 'nothing')); return b.title; })()",
          "name": "model picker shows OpenAI"
        }
      ]
    },
    {
      "name": "reads and delegates",
      "timeoutMs": 240000,
      "steps": [
        {
          "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "value": "You are Writer. Do this exactly once: read openai-brief.md, read openai-battle.sk, and call delegate_to_agent one time for a concise review. Do not repeat any successful tool call. After the delegated result returns, immediately reply with OPENAI-DELEGATE-4242 and stop."
        },
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toBeVisible": true,
          "timeoutMs": 20000,
          "name": "turn starts"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toHaveCount": 0,
          "timeoutMs": 180000,
          "name": "turn finishes"
        },
        {
          "expectLog": "engine=prompty agent="
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "cancels a long turn",
      "timeoutMs": 120000,
      "steps": [
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[aria-label=\"New Chat\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "value": "Read openai-brief.md, then write an extremely long, exhaustively detailed 2000-word narration script for a product demo about relational databases. Keep going with as much detail as possible."
        },
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toBeVisible": true,
          "timeoutMs": 20000,
          "name": "turn starts"
        },
        {
          "sleep": 2500
        },
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]",
          "toBeVisible": true,
          "timeoutMs": 60000,
          "name": "composer returns to idle"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toHaveCount": 0
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "mutates a sketch row",
      "timeoutMs": 240000,
      "steps": [
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[aria-label=\"New Chat\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "value": "You are Writer. Call update_planning_row exactly once for path openai-battle.sk row_number 1. Use expected_narrative exactly: Open with the product promise. Set narrative exactly: Open with the product promise. OPENAI-MUTATION-4242. Then read openai-battle.sk once. Do not repeat any successful tool call. Reply when persisted and stop."
        },
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toBeVisible": true,
          "timeoutMs": 20000,
          "name": "turn starts"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toHaveCount": 0,
          "timeoutMs": 180000,
          "name": "turn finishes"
        },
        {
          "expectLog": "engine=prompty agent="
        },
        {
          "expectNoErrors": true
        }
      ]
    },
    {
      "name": "updates storyboard and visual",
      "timeoutMs": 360000,
      "steps": [
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[aria-label=\"New Chat\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "toBeVisible": true,
          "timeoutMs": 15000
        },
        {
          "fill": "[data-testid=\"secondary-chat-panel\"] textarea[placeholder^=\"Ask about your demo plan\"]",
          "value": "You are Writer. Do this exactly once: update openai-battle.sb description to include OPENAI-STORYBOARD-4242, set one valid simple Elucim v2 visual on row 2 of openai-battle.sk, then review that visual once. Do not repeat any successful tool call. Reply with OPENAI-VISUAL-4242 and stop."
        },
        {
          "click": "[data-testid=\"secondary-chat-panel\"] button[title=\"Send (Enter)\"]"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toBeVisible": true,
          "timeoutMs": 20000,
          "name": "turn starts"
        },
        {
          "expect": "[data-testid=\"secondary-chat-panel\"] button[title=\"Stop generation\"]",
          "toHaveCount": 0,
          "timeoutMs": 300000,
          "name": "turn finishes"
        },
        {
          "expectLog": "engine=prompty agent="
        },
        {
          "expectNoErrors": true
        }
      ]
    }
  ]
}
