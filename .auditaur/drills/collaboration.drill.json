{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "Collaborating through a shared remote (a local bare repo): sending saves, getting a collaborator's saves, merging diverged work, resolving a conflicting edit, and adopting a collaborator's branch. Each test starts from the seeded project, whose first save (\"Initial plan\") is already on the remote's main, with the remote as origin (remote-setup.drill.json covers adding one).",
  "tags": ["@versioning", "@collaboration", "@local"],
  "env": { "GIT_AUTHOR_NAME": "Drill Author", "GIT_AUTHOR_EMAIL": "author@drill.test" },
  "setup": [
    { "name": "Create a project already shared through a remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/collaboration.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "sends saved work to a shared remote",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Agenda: demo." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Agenda drafted", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "click": { "testId": "titlebar-send" }, "timeoutMs": 15000 },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Up to date", "timeoutMs": 30000 },
        { "name": "the save reached the remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-remote", "Agenda drafted"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "gets a collaborator's saves",
      "steps": [
        { "name": "a collaborator sends a save", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "plan.md", "# Launch plan\n\nCollaborator agenda.\n", "Collaborator agenda"] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "click": { "role": "button", "name": "Get updates", "exact": true }, "timeoutMs": 15000 },
        { "name": "the collaborator's edit is in the project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Collaborator agenda."] },
        { "name": "their save is in local history", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Collaborator agenda" },
        { "name": "and keeps its author", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%an"], "stdout": "Drill Collaborator" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "resolves a conflicting edit by taking the incoming version",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": "Local wording." },
        { "name": "the local edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Local wording."] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Local wording", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a collaborator sends a conflicting save", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "plan.md", "# Launch plan\n\nDraft agenda.\nRemote wording.\n", "Remote wording"] },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Sync &", "timeoutMs": 15000 },
        { "click": { "testId": "titlebar-send" } },
        { "expect": { "text": "You and Drill Collaborator both changed plan.md" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Start incoming", "exact": true }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Apply Changes", "exact": true } },
        { "expect": { "role": "button", "name": "Apply Changes", "exact": true }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the incoming wording won", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Remote wording."] },
        { "name": "the local wording is gone", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Local wording."] },
        { "name": "history has both parents", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"] },
        { "name": "under the generated name", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Bring in team updates" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "replays unsent saves on top of a collaborator's saves, then sends",
      "steps": [
        { "click": { "testId": "explorer-item-agenda.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": "Local item." },
        { "name": "the local edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "agenda.md", "Local item."] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Local item", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a collaborator sends a save to another file", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "plan.md", "# Launch plan\n\nCollaborator agenda.\n", "Collaborator agenda"] },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Sync &", "timeoutMs": 15000 },
        { "name": "remember the local head", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Local item" },
        { "click": { "testId": "titlebar-send" } },
        { "expectIpc": "rebase_incoming", "status": "ok", "timeoutMs": 30000 },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Up to date", "timeoutMs": 30000 },
        { "name": "the collaborator's edit is in the project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Collaborator agenda."] },
        { "name": "the local edit is kept", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "agenda.md", "Local item."] },
        { "name": "no extra version was made", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"], "exitCode": 1 },
        { "name": "the local save is the head", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Local item" },
        { "name": "and reached the remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-remote", "Local item"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "adopts a collaborator's branch from the remote",
      "steps": [
        { "name": "a collaborator sends a new branch", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-branch", "pricing-review", "plan.md", "# Launch plan\n\nPricing review.\n", "Pricing review"] },
        { "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "expectIpc": "list_remote_variations", "status": "ok", "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "pricing-review" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Adopt and switch", "exact": true } },
        { "expectIpc": "adopt_remote_variation", "status": "ok", "timeoutMs": 30000 },
        { "expect": { "role": "button", "name": "Timeline pricing-review. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "the adopted branch is checked out", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["branch", "--show-current"], "stdout": "pricing-review" },
        { "name": "with the collaborator's edit", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Pricing review."] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "saves unsaved work as a version, then sends it",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Agenda: venue." },
        { "name": "the edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Agenda: venue."] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Save & send", "timeoutMs": 15000 },
        { "click": { "testId": "titlebar-send" } },
        { "expect": { "testId": "send-save-first" }, "toContainText": "Save these changes as a version before sending.", "timeoutMs": 15000 },
        { "fill": { "testId": "version-name-input", "within": { "testId": "send-save-first" } }, "value": "Venue booked" },
        { "click": { "testId": "version-save", "within": { "testId": "send-save-first" } } },
        { "expect": { "testId": "titlebar-send" }, "toContainText": "Up to date", "timeoutMs": 30000 },
        { "name": "the version is in history", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Venue booked" },
        { "name": "and reached the remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-remote", "Venue booked"] },
        { "expectNoErrors": true }
      ]
    }
  ]
}
