{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "Collaborating through a shared remote (a local bare repo): sending saves, getting a collaborator's saves, and resolving a conflicting edit. Each test starts from the seeded project, whose first save (\"Initial plan\") is already on the remote's main, with the remote as origin (the app has no add-remote UI).",
  "tags": ["@versioning", "@collaboration", "@local"],
  "env": { "GIT_AUTHOR_NAME": "Drill Author", "GIT_AUTHOR_EMAIL": "author@drill.test" },
  "setup": [
    { "name": "Create a project already shared through a remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/collaboration.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "sends saved work to a shared remote",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Agenda: demo." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "activity-changes" } },
        { "click": { "role": "button", "name": "Save snapshot", "exact": true }, "timeoutMs": 15000 },
        { "fill": "#snapshot-name-input", "value": "Agenda drafted" },
        { "click": { "role": "button", "name": "Save Snapshot", "exact": true } },
        { "expect": "#snapshot-name-input", "toHaveCount": 0, "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Share changes with collaborators", "exact": true }, "timeoutMs": 15000 },
        { "expect": { "role": "button", "name": "Share changes with collaborators", "exact": true }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the save reached the remote", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-remote", "Agenda drafted"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "gets a collaborator's saves",
      "steps": [
        { "name": "a collaborator sends a save", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "plan.md", "# Launch plan\n\nCollaborator agenda.\n", "Collaborator agenda"] },
        { "click": { "testId": "activity-changes" } },
        { "click": { "role": "button", "name": "Check for updates without changing your files", "exact": true } },
        { "click": { "role": "button", "name": "Get updates with collaborators", "exact": true }, "timeoutMs": 15000 },
        { "name": "the collaborator's edit is in the project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Collaborator agenda."] },
        { "name": "their save is in local history", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Collaborator agenda" },
        { "name": "and keeps its author", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%an"], "stdout": "Drill Collaborator" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "resolves a conflicting edit by taking the incoming version",
      "steps": [
        { "click": { "testId": "activity-project" } },
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": "Local wording." },
        { "name": "the local edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Local wording."] },
        { "click": { "testId": "activity-changes" } },
        { "click": { "role": "button", "name": "Save snapshot", "exact": true }, "timeoutMs": 15000 },
        { "fill": "#snapshot-name-input", "value": "Local wording" },
        { "click": { "role": "button", "name": "Save Snapshot", "exact": true } },
        { "expect": "#snapshot-name-input", "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a collaborator sends a conflicting save", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "plan.md", "# Launch plan\n\nDraft agenda.\nRemote wording.\n", "Remote wording"] },
        { "click": { "role": "button", "name": "Check for updates without changing your files", "exact": true } },
        { "click": { "role": "button", "name": "Sync with collaborators", "exact": true }, "timeoutMs": 15000 },
        { "expect": { "text": "Merging origin into current workspace" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Start incoming", "exact": true }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Apply Changes", "exact": true } },
        { "name": "the incoming wording won", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Remote wording."] },
        { "name": "the local wording is gone", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Local wording."] },
        { "name": "history has both parents", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"] },
        { "expectNoErrors": true }
      ]
    }
  ]
}