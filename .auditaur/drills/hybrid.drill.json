{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "A hybrid project: a CutReady folder (cutready/) inside a developer's code repo, checked out on a cutready/ branch, with main shared through a local bare remote. Covers folder-scoped saves, namespaced timelines, getting updates from main with merge naming, and history.",
  "tags": ["@versioning", "@hybrid", "@local"],
  "env": { "GIT_AUTHOR_NAME": "Drill Author", "GIT_AUTHOR_EMAIL": "author@drill.test" },
  "setup": [
    { "name": "Create a code repo with a CutReady folder", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/hybrid.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded repo", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "saves only the CutReady folder, leaving code untouched",
      "steps": [
        { "name": "a developer edits code outside the folder", "run": "node", "cwd": "${CUTREADY_REPO}", "args": ["-e", "require('fs').appendFileSync('src/app.js','// dev edit\\n')"] },
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Hybrid agenda." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Hybrid plan", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the version is on the checked-out branch", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["log", "-1", "--format=%s"], "stdout": "Hybrid plan" },
        { "name": "and stays on it", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["branch", "--show-current"], "stdout": "cutready/draft" },
        { "name": "it commits the folder", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["show", "--name-only", "--format=", "HEAD", "--", "cutready/plan.md"], "stdout": "cutready/plan.md" },
        { "name": "and not the developer's code", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["diff", "--quiet", "HEAD^", "HEAD", "--", "src"], "exitCode": 0 },
        { "name": "whose edit is still pending", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["diff", "--quiet", "HEAD", "--", "src/app.js"], "exitCode": 1 },
        { "name": "the managed folder is named at the repo root", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "repo:.draftline", "cutready"] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "puts new timelines in the cutready/ namespace",
      "steps": [
        { "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "New timeline…", "exact": true } },
        { "fill": { "label": "New timeline name" }, "value": "recap" },
        { "press": "Enter", "target": { "label": "New timeline name" } },
        { "expectIpc": "create_variation_from_version_guarded", "status": "ok", "timeoutMs": 15000 },
        { "name": "the timeline is namespaced", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["rev-parse", "--verify", "--quiet", "refs/heads/cutready/recap"] },
        { "name": "no bare branch was made", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["rev-parse", "--verify", "--quiet", "refs/heads/recap"], "exitCode": 1 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "gets updates from main under an approved merge name",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Hybrid agenda." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Local plan", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a developer sends an update to main", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "cutready/agenda.md", "# Agenda\n\nTeam agenda.\n", "Team agenda"] },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "expect": { "testId": "remote-status" }, "toContainText": "1 new change on main", "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Get updates", "exact": true, "within": { "testId": "remote-status" } } },
        { "expect": { "testId": "merge-name-input" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "fill": { "testId": "merge-name-input" }, "value": "Bring in team agenda" },
        { "click": { "testId": "merge-name-confirm" } },
        { "expectIpc": "merge_incoming_with_token", "status": "ok", "timeoutMs": 30000 },
        { "name": "history has both parents", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"] },
        { "name": "under the approved name", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["log", "-1", "--format=%s"], "stdout": "Bring in team agenda" },
        { "name": "on the CutReady branch", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["branch", "--show-current"], "stdout": "cutready/draft" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "cancelling the merge name brings nothing in",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Hybrid agenda." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Local plan", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a developer sends an update to main", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "cutready/agenda.md", "# Agenda\n\nTeam agenda.\n", "Team agenda"] },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "expect": { "testId": "remote-status" }, "toContainText": "1 new change on main", "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Get updates", "exact": true, "within": { "testId": "remote-status" } } },
        { "expect": { "testId": "merge-name-input" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Cancel", "exact": true, "within": { "testId": "merge-name-dialog" } } },
        { "expect": { "testId": "merge-name-dialog" }, "toHaveCount": 0, "timeoutMs": 15000 },
        { "name": "no merge was made", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"], "exitCode": 1 },
        { "name": "the head is still the local save", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["log", "-1", "--format=%s"], "stdout": "Local plan" },
        { "name": "nothing is pending", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["diff", "--quiet", "HEAD", "--", "cutready"], "exitCode": 0 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "resolves a conflicting update from main, then names the merge",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Hybrid agenda." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Local plan", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "a developer sends a conflicting edit to main", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "collaborator-save", "cutready/plan.md", "# Launch plan\n\nDraft agenda.\nTeam wording.\n", "Team wording"] },
        { "click": { "role": "button", "name": "Check", "exact": true } },
        { "expect": { "testId": "remote-status" }, "toContainText": "1 new change on main", "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Get updates", "exact": true, "within": { "testId": "remote-status" } } },
        { "click": { "role": "button", "name": "Start incoming", "exact": true }, "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Apply Changes", "exact": true } },
        { "expect": { "testId": "merge-name-input" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "fill": { "testId": "merge-name-input" }, "value": "Take team wording" },
        { "click": { "testId": "merge-name-confirm" } },
        { "expect": { "testId": "merge-name-dialog" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the incoming wording won", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Team wording."] },
        { "name": "the local wording is gone", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Hybrid agenda."] },
        { "name": "history has both parents", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"] },
        { "name": "under the approved name", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["log", "-1", "--format=%s"], "stdout": "Take team wording" },
        { "name": "on the CutReady branch", "run": "git", "cwd": "${CUTREADY_REPO}", "args": ["branch", "--show-current"], "stdout": "cutready/draft" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "shows the folder's history",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Hybrid agenda." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Hybrid plan", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "click": { "testId": "open-history" }, "timeoutMs": 15000 },
        { "expect": { "testId": "history-tab" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expect": { "testId": "history-entry", "nth": 0 }, "toContainText": "Hybrid plan", "timeoutMs": 15000 },
        { "click": { "testId": "history-entry-menu", "nth": 0 } },
        { "click": { "role": "menuitem", "name": "Compare with previous" } },
        { "expect": { "testId": "compare-tab" }, "toContainText": "Hybrid agenda.", "timeoutMs": 15000 },
        { "expectNoErrors": true }
      ]
    }
  ]
}
