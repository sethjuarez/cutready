{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "Local versioning: pending changes, diffs, named versions, discarding a file, previewing history, branching from a snapshot, switching timelines, and setting unsaved work aside (several sets, delete, overlap), discarding everything with Undo, ✨ Suggest with a mock model, and creating and renaming timelines. Each test starts from a seeded history: \"Agenda drafted\" then \"Pricing added\" on main, and an alt-intro branch at \"Agenda drafted\".",
  "tags": ["@versioning"],
  "env": { "GIT_AUTHOR_NAME": "Drill Versioning", "GIT_AUTHOR_EMAIL": "versioning@drill.test" },
  "setup": [
    { "name": "Create a project with one note and the env identity", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/versioning.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "lists an edited note as a pending change",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Venue." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "testId": "changes-summary-toggle" }, "timeoutMs": 15000 },
        { "expect": { "role": "button", "name": "View diff: plan.md" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expect": { "testId": "version-name-input" }, "toBeVisible": true },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "shows the diff of a pending change",
      "steps": [
        { "name": "an edited note", "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Venue." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "testId": "changes-summary-toggle" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "View diff: plan.md" } },
        { "expect": { "text": "plan (diff)" }, "toBeVisible": true },
        { "expect": { "text": "Venue." }, "toBeVisible": true },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "saves a named version",
      "steps": [
        { "name": "an edited note", "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Venue." },
        { "expectIpc": "update_note", "status": "ok" },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "Venue noted", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the snapshot is the latest commit", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Venue noted" },
        { "expect": { "text": "Everything is saved as a version." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "discards one file's pending edit",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Scratch idea." },
        { "name": "the scratch edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Scratch idea."] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "testId": "changes-summary-toggle" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Discard changes to plan.md" }, "timeoutMs": 15000 },
        { "expectIpc": "selected_shelve", "status": "ok", "timeoutMs": 15000 },
        { "name": "the scratch edit is gone", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Scratch idea."] },
        { "name": "the saved edit is kept", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Agenda: demo."] },
        { "expect": { "text": "Everything is saved as a version." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expect": { "text": "Discarded 1 change" }, "toBeVisible": true },
        { "click": { "role": "button", "name": "Undo", "exact": true } },
        { "expectIpc": "apply_shelf", "status": "ok", "timeoutMs": 15000 },
        { "expect": { "text": "Discarded changes restored." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "Undo brought the scratch edit back", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Scratch idea."] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "saves a snapshot from the keyboard",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Timeline." },
        { "name": "the timeline edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Timeline."] },
        { "press": "ControlOrMeta+s" },
        { "fill": { "testId": "version-name-input" }, "value": "Timeline added", "timeoutMs": 15000 },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the snapshot is the latest commit", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Timeline added" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "previews an earlier snapshot",
      "steps": [
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "role": "button", "name": "Preview version: Agenda drafted" }, "timeoutMs": 15000 },
        { "expect": { "text": "Snapshot: Agenda drafted" }, "toBeVisible": true },
        { "expect": { "role": "button", "name": "Start Branch from Here" }, "toBeVisible": true },
        { "name": "previewing leaves the workspace untouched", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Pricing."] },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "starts a branch from the earlier snapshot",
      "steps": [
        { "name": "preview the earlier snapshot", "click": { "testId": "titlebar-sync-status" } },
        { "click": { "role": "button", "name": "Preview version: Agenda drafted" }, "timeoutMs": 15000 },
        { "expect": { "text": "Snapshot: Agenda drafted" }, "toBeVisible": true },
        { "click": { "role": "button", "name": "Start Branch from Here" } },
        { "fill": { "label": "New branch name" }, "value": "alt-agenda" },
        { "click": { "role": "button", "name": "Create Branch", "exact": true } },
        { "click": { "role": "button", "name": "Confirm Start Branch", "exact": true } },
        { "expectIpc": "create_variation_from_version_guarded", "status": "ok", "timeoutMs": 15000 },
        { "name": "the workspace has the earlier snapshot's content", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Pricing."] },
        { "name": "the new branch is checked out", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["branch", "--show-current"], "stdout": "alt-agenda" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "switches back to the main timeline",
      "steps": [
        { "name": "be on another timeline", "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Switch to timeline alt-intro" } },
        { "expect": { "role": "button", "name": "Timeline alt-intro. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "the workspace has alt-intro's content", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Pricing."] },
        { "name": "unsaved work on alt-intro", "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Intro beat." },
        { "name": "the unsaved edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Intro beat."] },
        { "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Switch to timeline main" } },
        { "fill": { "testId": "version-name-input" }, "value": "Intro beat added", "timeoutMs": 15000 },
        { "fill": { "label": "Comment" }, "value": "Saved before switching." },
        { "click": { "role": "button", "name": "Save version & continue", "exact": true } },
        { "name": "the save-and-continue switch finished", "expect": { "role": "button", "name": "Timeline main. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "expectIpc": "switch_variation", "status": "ok", "timeoutMs": 30000 },
        { "name": "the workspace has main's content", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Pricing."] },
        { "name": "the alt-intro edit stayed on alt-intro", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Intro beat."] },
        { "name": "main is checked out", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["branch", "--show-current"], "stdout": "main" },
        { "name": "the version name is alt-intro's latest subject", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s", "alt-intro"], "stdout": "Intro beat added" },
        { "name": "with the comment as its body", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%b", "alt-intro"], "stdout": "Saved before switching." },
        { "name": "the saved edit is in alt-intro", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["grep", "-q", "Intro beat.", "alt-intro", "--", "plan.md"] },
        { "name": "and the workspace is clean", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["diff", "--quiet", "HEAD", "--", "plan.md"], "exitCode": 0 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "sets unsaved work aside when switching timelines, then restores it",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Shelved thought." },
        { "name": "the unsaved edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Shelved thought."] },
        { "click": { "testId": "titlebar-variation" } },
        { "click": { "role": "button", "name": "Switch to timeline alt-intro" } },
        { "click": { "testId": "pre-action-set-aside" }, "timeoutMs": 15000 },
        { "expectIpc": "selected_shelve", "status": "ok", "timeoutMs": 15000 },
        { "expectIpc": "switch_variation", "status": "ok", "timeoutMs": 15000 },
        { "name": "the shelved edit left the workspace", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Shelved thought."] },
        { "click": { "testId": "titlebar-variation" } },
        { "click": { "role": "button", "name": "Switch to timeline main" } },
        { "expect": { "role": "button", "name": "Timeline main. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expect": { "role": "button", "name": "Restore Before switching to alt-intro", "exact": true }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Restore Before switching to alt-intro", "exact": true } },
        { "expectIpc": "apply_shelf", "status": "ok", "timeoutMs": 15000 },
        { "expectIpc": "delete_shelf", "status": "ok" },
        { "name": "the shelved edit is back", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Shelved thought."] },
        { "expect": { "role": "button", "name": "Restore Before switching to alt-intro", "exact": true }, "toHaveCount": 0, "timeoutMs": 15000 },
        { "expectNoTelemetry": { "pattern": "Drill Versioning|versioning@drill\\.test" }, "name": "identity stays out of telemetry" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "merges another timeline into the current one under an approved name",
      "steps": [
        { "name": "start a timeline from the latest version", "click": { "testId": "titlebar-sync-status" } },
        { "click": { "role": "button", "name": "Preview version: Pricing added" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Start Branch from Here" } },
        { "fill": { "label": "New branch name" }, "value": "encore" },
        { "click": { "role": "button", "name": "Create Branch", "exact": true } },
        { "click": { "role": "button", "name": "Confirm Start Branch", "exact": true } },
        { "expect": { "role": "button", "name": "Timeline encore. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "edit on encore", "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Encore." },
        { "name": "the edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Encore."] },
        { "name": "save it on encore and switch back to main", "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Switch to timeline main" } },
        { "fill": { "testId": "version-name-input" }, "value": "Encore added", "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Save version & continue", "exact": true } },
        { "expect": { "role": "button", "name": "Timeline main. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "name": "main doesn't have the encore yet", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Encore."] },
        { "name": "merge encore into main", "click": { "testId": "titlebar-variation" }, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Merge encore into main" } },
        { "expectIpc": "preflight_merge_variation", "status": "ok", "timeoutMs": 15000 },
        { "name": "the merge waits for a name", "expect": { "testId": "merge-name-dialog" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "fill": { "testId": "merge-name-input" }, "value": "Bring in the encore" },
        { "click": { "testId": "merge-name-confirm" } },
        { "expectIpc": "merge_variation_with_resolutions", "status": "ok", "timeoutMs": 30000 },
        { "name": "the workspace has the encore", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Encore."] },
        { "name": "still on main", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["branch", "--show-current"], "stdout": "main" },
        { "name": "the merge has two parents", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"], "exitCode": 0 },
        { "name": "and only two", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^3"], "exitCode": 1 },
        { "name": "its second parent is encore's tip", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["merge-base", "--is-ancestor", "HEAD^2", "encore"], "exitCode": 0 },
        { "name": "and encore's tip is its second parent", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["merge-base", "--is-ancestor", "encore", "HEAD^2"], "exitCode": 0 },
        { "name": "under the approved name", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Bring in the encore" },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "deletes an abandoned timeline that has no new versions",
      "steps": [
        { "click": { "testId": "titlebar-sync-status" } },
        { "click": { "role": "button", "name": "Preview version: Agenda drafted" }, "timeoutMs": 15000 },
        { "expect": { "text": "Snapshot: Agenda drafted" }, "toBeVisible": true },
        { "click": { "role": "button", "name": "Start Branch from Here" } },
        { "fill": { "label": "New branch name" }, "value": "scratch" },
        { "click": { "role": "button", "name": "Create Branch", "exact": true } },
        { "click": { "role": "button", "name": "Confirm Start Branch", "exact": true } },
        { "expect": { "role": "button", "name": "Timeline scratch. Switch or manage timelines" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "testId": "explorer-item-plan.md" } },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Throwaway." },
        { "name": "the unsaved edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Throwaway."] },
        { "click": { "testId": "titlebar-variation" } },
        { "click": { "role": "button", "name": "Switch to timeline main" } },
        { "click": { "testId": "pre-action-set-aside" }, "timeoutMs": 15000 },
        { "expect": { "text": "Delete the empty timeline too?" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Delete timeline", "exact": true } },
        { "expectIpc": "delete_variation", "status": "ok", "timeoutMs": 15000 },
        { "expect": { "role": "button", "name": "Timeline main. Switch or manage timelines" }, "toBeVisible": true },
        { "name": "the set-aside edit left the workspace", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:Throwaway."] },
        { "name": "the branch no longer exists", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "refs/heads/scratch"], "exitCode": 1 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "saves a version named and described by ✨ Suggest",
      "steps": [
        { "name": "Enter the dummy key for the mock connection", "click": { "testId": "activity-settings" } },
        { "click": { "testId": "settings-scope-app" } },
        { "click": { "testId": "settings-tab-ai" } },
        { "click": { "testId": "settings-ai-tab-connections" } },
        { "expect": "input[placeholder=\"Enter your API key\"]", "toBeVisible": true, "timeoutMs": 15000 },
        { "fill": "input[placeholder=\"Enter your API key\"]", "value": "drill-dummy-key" },
        { "expect": "body", "toContainText": "Key saved", "timeoutMs": 10000 },
        { "click": { "testId": "settings-close" } },
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Suggested edit." },
        { "name": "the edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Suggested edit."] },
        { "click": { "testId": "titlebar-sync-status" } },
        { "fill": { "testId": "version-name-input" }, "value": "My own name", "timeoutMs": 15000 },
        { "click": { "testId": "version-suggest" } },
        { "name": "Suggest asks before replacing a typed name", "click": { "role": "button", "name": "Replace", "exact": true }, "timeoutMs": 30000 },
        { "expect": { "testId": "version-name-input" }, "toHaveValue": "Mock version name", "timeoutMs": 15000 },
        { "expect": { "label": "Comment" }, "toHaveValue": "Mock version comment." },
        { "name": "the model saw a version-naming request", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-mock-llm", "e.suggest === 'version'"] },
        { "click": { "testId": "version-save" } },
        { "expect": { "testId": "version-name-input" }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "name": "the suggested name is the subject", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%s"], "stdout": "Mock version name" },
        { "name": "and the suggested comment is the body", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["log", "-1", "--format=%b"], "stdout": "Mock version comment." },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "cancelling the pre-action dialog keeps the work and the timeline",
      "steps": [
        { "click": { "testId": "explorer-item-plan.md" }, "timeoutMs": 45000 },
        { "click": { "label": "Note content" } },
        { "press": "Control+End", "target": { "label": "Note content" } },
        { "type": { "label": "Note content" }, "value": " Kept thought." },
        { "name": "the edit is on disk", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Kept thought."] },
        { "click": { "testId": "titlebar-variation" } },
        { "click": { "role": "button", "name": "Switch to timeline alt-intro" } },
        { "expect": { "testId": "pre-action-dialog" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "click": { "role": "button", "name": "Cancel", "exact": true, "within": { "testId": "pre-action-dialog" } } },
        { "expect": { "testId": "pre-action-dialog" }, "toHaveCount": 0, "timeoutMs": 15000 },
        { "name": "still on main", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["branch", "--show-current"], "stdout": "main" },
        { "name": "the edit is still there", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Kept thought."] },
        { "name": "nothing was set aside", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["rev-parse", "--verify", "--quiet", "HEAD^2"], "exitCode": 1 },
