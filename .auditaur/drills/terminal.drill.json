{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "The workspace terminal runs shell commands in the project folder. Outcomes are checked through files the shell writes, not through rendered terminal text.",
  "tags": ["@terminal", "@local"],
  "setup": [
    { "name": "Create a project with one note", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/terminal.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "runs a command in the workspace terminal",
      "steps": [
        { "press": "Control+Shift+P" },
        { "fill": { "role": "combobox", "name": "Search commands" }, "value": "Open Workspace Terminal" },
        { "press": "Enter", "target": { "role": "combobox", "name": "Search commands" } },
        { "name": "a terminal session opened (terminal_open streams over a Channel, so it is not in recorded IPC)", "expect": { "role": "button", "name": "Close Terminal" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "name": "the shell session is ready (keys typed while it starts are dropped)", "expect": { "text": "Starting terminal..." }, "toHaveCount": 0, "timeoutMs": 30000 },
        { "click": { "label": "Terminal input" } },
        { "type": { "label": "Terminal input" }, "value": "node -e \"require('fs').writeFileSync('drill-terminal.txt','drill-ok')\"" },
        { "press": "Enter", "target": { "label": "Terminal input" } },
        { "expectIpc": "terminal_write", "status": "ok" },
        { "name": "the command ran in the project folder", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "drill-terminal.txt", "drill-ok"], "timeoutMs": 30000 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "closes the workspace terminal",
      "steps": [
        { "press": "Control+Shift+P" },
        { "fill": { "role": "combobox", "name": "Search commands" }, "value": "Open Workspace Terminal" },
        { "press": "Enter", "target": { "role": "combobox", "name": "Search commands" } },
        { "name": "a terminal session opened (terminal_open streams over a Channel, so it is not in recorded IPC)", "expect": { "role": "button", "name": "Close Terminal" }, "toBeVisible": true, "timeoutMs": 30000 },
        { "click": { "role": "button", "name": "Close Terminal" } },
        { "expectIpc": "terminal_close", "status": "ok" },
        { "expect": { "role": "button", "name": "Close Terminal" }, "toHaveCount": 0 },
        { "expectNoErrors": true }
      ]
    }
  ]
}