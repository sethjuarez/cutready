{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "description": "Recovering from a crash: an interrupted operation is finished or dismissed from the project health banner, and a lock left by a closed CutReady is cleared. Each test seeds Draftline's own on-disk state (.git/draftline/recovery.json, operation.lock) once the app has opened the project, then reloads.",
  "tags": ["@recovery", "@versioning"],
  "env": { "GIT_AUTHOR_NAME": "Drill Recovery", "GIT_AUTHOR_EMAIL": "recovery@drill.test" },
  "setup": [
    { "name": "Create a project with one saved note", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/recovery.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 }
  ],
  "tests": [
    {
      "name": "finishing an interrupted discard restores the last save",
      "steps": [
        { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "click": { "testId": "activity-changes" } },
        { "click": { "role": "button", "name": "Save snapshot", "exact": true } },
        { "fill": "#snapshot-name-input", "value": "Plan baseline" },
        { "click": { "role": "button", "name": "Save Snapshot", "exact": true } },
        { "expect": "#snapshot-name-input", "toHaveCount": 0, "timeoutMs": 30000 },
        { "expect": { "text": "No workspace changes since last snapshot" }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "an unsaved edit", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "write", "plan.md", "# Launch plan\n\nRECOVERY-DRILL finish edit.\n"] },
        { "name": "a discard that crashed midway", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "write", ".git/draftline/recovery.json", "{\"operation_id\":\"drill-discard-finish\",\"operation\":\"DiscardChanges\",\"original_variation\":null,\"target\":null,\"completed\":false}"] },
        { "reload": true },
        { "expect": { "testId": "project-health-recovery" }, "toContainText": "discard was interrupted", "timeoutMs": 45000 },
        { "click": { "role": "button", "name": "Finish", "exact": true } },
        { "expectIpc": "repair_recovery", "status": "ok" },
        { "expect": { "testId": "project-health-recovery" }, "toBeHidden": true, "timeoutMs": 15000 },
        { "name": "the edit was discarded", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "lacks:RECOVERY-DRILL"] },
        { "name": "the saved text is back", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "Draft agenda."] },
        { "expectNoErrors": true, "ignore": ["incomplete Draftline operation", "recovery_required"], "name": "no errors besides reads Draftline refuses while the recovery is pending" }
      ]
    },
    {
      "name": "dismissing an interrupted operation keeps the files as they are",
      "steps": [
        { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "name": "an unsaved edit", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "write", "plan.md", "# Launch plan\n\nRECOVERY-DRILL dismiss edit.\n"] },
        { "name": "a discard that crashed midway", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "write", ".git/draftline/recovery.json", "{\"operation_id\":\"drill-discard-dismiss\",\"operation\":\"DiscardChanges\",\"original_variation\":null,\"target\":null,\"completed\":false}"] },
        { "reload": true },
        { "expect": { "testId": "project-health-recovery" }, "toContainText": "discard was interrupted", "timeoutMs": 45000 },
        { "click": { "role": "button", "name": "Dismiss", "exact": true } },
        { "expectIpc": "acknowledge_recovery", "status": "ok" },
        { "expect": { "testId": "project-health-recovery" }, "toBeHidden": true, "timeoutMs": 15000 },
        { "name": "the edit is kept", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", "plan.md", "RECOVERY-DRILL dismiss edit."] },
        { "reload": true },
        { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "name": "the banner stays dismissed after reopening", "expect": { "testId": "project-health-recovery" }, "toBeHidden": true },
        { "expectNoErrors": true, "ignore": ["incomplete Draftline operation", "recovery_required"], "name": "no errors besides reads Draftline refuses while the recovery is pending" }
      ]
    },
    {
      "name": "a lock left by a closed CutReady is cleared",
      "steps": [
        { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 },
        { "name": "a lock from a long-gone process", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "write", ".git/draftline/operation.lock", "{\"operation_id\":\"drill-stale-lock\",\"operation\":\"save_version\",\"process_id\":4294967295,\"owner\":null,\"created_at_seconds\":1,\"host\":null}"] },
        { "reload": true },
        { "expect": { "testId": "project-health-stale-lock" }, "toContainText": "left the project locked", "timeoutMs": 45000 },
        { "click": { "role": "button", "name": "Clear lock", "exact": true } },
        { "expectIpc": "clear_stale_lock", "status": "ok" },
        { "expect": { "testId": "project-health-stale-lock" }, "toBeHidden": true, "timeoutMs": 15000 },
        { "name": "the lock file is gone", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-file", ".git/draftline/operation.lock", "absent"] },
        { "expectNoErrors": true }
      ]
    }
  ]
}
