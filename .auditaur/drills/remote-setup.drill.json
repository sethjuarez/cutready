{
  "$schema": "https://auditaur.dev/schemas/drill.schema.json",
  "serial": true,
  "description": "Connecting a project to a remote from Settings > Repository. The seeded project's first save (\"Initial plan\") is already on a local bare repo, but the project has no remotes.",
  "tags": ["@versioning", "@collaboration", "@local"],
  "setup": [
    { "name": "Create a project with no remotes and an existing shared repo", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "setup", ".auditaur/fixtures/remote-setup.json"] }
  ],
  "teardown": [
    { "name": "Remove fixture", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "teardown"], "always": true }
  ],
  "beforeEach": [
    { "name": "Drop pending autosaves and per-test UI state", "clearStorage": true },
    { "name": "a project is open", "expect": { "testId": "explorer-import-menu" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "Restore the seeded project", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "reset"] },
    { "name": "Reload the restored project with clean UI state", "clearStorage": true },
    { "expect": { "testId": "explorer-item-plan.md" }, "toBeVisible": true, "timeoutMs": 45000 },
    { "name": "the project starts with no remotes", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["remote", "get-url", "origin"], "exitCode": 2 }
  ],
  "tests": [
    {
      "name": "adds origin from the Remote URL field",
      "steps": [
        { "click": { "testId": "activity-settings" } },
        { "click": { "testId": "settings-scope-workspace" } },
        { "click": { "testId": "settings-tab-repository" } },
        { "fill": { "placeholder": "https://github.com/user/repo.git" }, "value": "${CUTREADY_REMOTE_URL}" },
        { "click": { "role": "button", "name": "Test", "exact": true } },
        { "expectIpc": "add_remote", "status": "ok" },
        { "expect": { "text": "Remote 'origin' added successfully." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "the project now has origin", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["remote"], "stdout": "origin" },
        { "name": "the URL is kept in workspace settings", "run": "node", "args": ["scripts/auditaur-drill-fixture.mjs", "expect-json", ".cutready/settings.json", "doc.repoRemoteUrl.endsWith('-remote.git')"] },
        { "name": "testing again finds the configured remote", "click": { "role": "button", "name": "Test", "exact": true } },
        { "expect": { "text": "Remote is configured and accessible." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "expectNoErrors": true }
      ]
    },
    {
      "name": "refuses a remote URL with embedded credentials",
      "steps": [
        { "click": { "testId": "activity-settings" } },
        { "click": { "testId": "settings-scope-workspace" } },
        { "click": { "testId": "settings-tab-repository" } },
        { "fill": { "placeholder": "https://github.com/user/repo.git" }, "value": "https://drill-user:drill-secret-4417@example.invalid/repo.git" },
        { "click": { "role": "button", "name": "Test", "exact": true } },
        { "expectIpc": "add_remote", "status": "error" },
        { "expect": { "text": "Remote URLs must not include credentials." }, "toBeVisible": true, "timeoutMs": 15000 },
        { "name": "no remote was added", "run": "git", "cwd": "${CUTREADY_PROJECT}", "args": ["remote", "get-url", "origin"], "exitCode": 2 },
        { "name": "the URL is not saved to workspace settings", "run": "node", "cwd": "${CUTREADY_PROJECT}", "args": ["-e", "const fs = require('fs'); const f = '.cutready/settings.json'; process.exit(fs.existsSync(f) && fs.readFileSync(f, 'utf8').includes('drill-secret-4417') ? 1 : 0)"] },
        { "expectNoTelemetry": { "pattern": "drill-secret-4417" }, "name": "the password stays out of telemetry" }
      ]
    }
  ]
}
