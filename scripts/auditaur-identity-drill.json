{
  "app": "cutready",
  "label": "identity",
  "timeoutSeconds": 240,
  "env": {
    "GIT_AUTHOR_NAME": "Drill Env",
    "GIT_AUTHOR_EMAIL": "env@drill.test"
  },
  "appStores": [
    { "file": "identity.json", "clear": true }
  ],
  "fixture": {
    "prefix": "cutready-identity-drill-",
    "sketches": [
      {
        "path": "intro.sk",
        "title": "Identity Drill Fixture",
        "narrative": "A sketch so the first snapshot has content."
      }
    ]
  },
  "steps": [
    {
      "id": "wait-for-shell",
      "drive": "wait",
      "selector": "[data-testid=\"activity-settings\"]",
      "timeoutMs": 45000
    },
    {
      "id": "open-settings",
      "drive": "click",
      "selector": "[data-testid=\"activity-settings\"]"
    },
    {
      "id": "wait-profile-tab",
      "drive": "wait",
      "selector": "[data-testid=\"settings-tab-profile\"]",
      "timeoutMs": 15000
    },
    {
      "id": "open-profile-tab",
      "drive": "click",
      "selector": "[data-testid=\"settings-tab-profile\"]"
    },
    {
      "id": "wait-profile-card",
      "drive": "wait",
      "selector": "[data-testid=\"profile-current\"]",
      "timeoutMs": 15000
    },
    {
      "id": "detected-identity-shown",
      "expectText": "Drill Env <env@drill.test>",
      "timeoutMs": 15000
    },
    {
      "id": "detected-source-is-environment",
      "drive": "evaluate",
      "expression": "(function(){var c=document.querySelector('[data-testid=\"profile-current\"]');return c?c.textContent:'no-card';})()",
      "expectContains": "GIT_AUTHOR environment variables"
    },
    {
      "id": "no-reset-without-profile",
      "drive": "evaluate",
      "expression": "(function(){return document.querySelector('[data-testid=\"profile-reset\"]')?'reset-shown':'hidden';})()",
      "expectValue": "hidden"
    },
    {
      "id": "fill-profile-name",
      "drive": "fill",
      "selector": "[data-testid=\"profile-name-input\"]",
      "value": "Drill Profile"
    },
    {
      "id": "fill-profile-email",
      "drive": "fill",
      "selector": "[data-testid=\"profile-email-input\"]",
      "value": "profile@drill.test"
    },
    {
      "id": "save-profile",
      "drive": "click",
      "selector": "[data-testid=\"profile-save\"]"
    },
    {
      "id": "profile-identity-shown",
      "expectText": "Drill Profile <profile@drill.test>",
      "timeoutMs": 15000
    },
    {
      "id": "profile-source-shown",
      "drive": "evaluate",
      "expression": "(function(){var c=document.querySelector('[data-testid=\"profile-current\"]');return c?c.textContent:'no-card';})()",
      "expectContains": "your CutReady profile"
    },
    {
      "id": "close-settings",
      "drive": "click",
      "selector": "[data-testid=\"settings-close\"]"
    },
    {
      "id": "open-snapshot-dialog",
      "drive": "evaluate",
      "expression": "(function(){window.dispatchEvent(new KeyboardEvent('keydown',{key:'s',ctrlKey:true,bubbles:true,cancelable:true}));return 'sent';})()",
      "expectValue": "sent"
    },
    {
      "id": "wait-snapshot-identity",
      "drive": "wait",
      "selector": "[data-testid=\"snapshot-identity\"]",
      "timeoutMs": 15000
    },
    {
      "id": "snapshot-shows-saving-as",
      "drive": "evaluate",
      "expression": "(function(){var n=document.querySelector('[data-testid=\"snapshot-identity\"]');return n?n.textContent:'no-notice';})()",
      "expectContains": "Saving as Drill Profile <profile@drill.test>"
    },
    {
      "id": "no-inline-identity-fields",
      "drive": "evaluate",
      "expression": "(function(){return document.getElementById('snapshot-author-email-input')?'fields-shown':'hidden';})()",
      "expectValue": "hidden"
    },
    {
      "id": "save-snapshot",
      "drive": "evaluate",
      "expression": "(function(){var b=Array.from(document.querySelectorAll('button')).find(function(x){return x.textContent.trim()==='Save Snapshot';});if(!b)return 'no-button';if(b.disabled)return 'disabled';b.click();return 'clicked';})()",
      "expectValue": "clicked"
    },
    {
      "id": "snapshot-author-is-profile",
      "git": ["log", "-1", "--format=%an <%ae>"],
      "expectContains": "Drill Profile <profile@drill.test>",
      "timeoutMs": 30000
    },
    {
      "id": "snapshot-dialog-closed",
      "drive": "evaluate",
      "expression": "(function(){return document.querySelector('[data-testid=\"snapshot-identity\"]')?'open':'closed';})()",
      "expectValue": "closed"
    },
    {
      "id": "reopen-settings",
      "drive": "click",
      "selector": "[data-testid=\"activity-settings\"]"
    },
    {
      "id": "wait-profile-tab-again",
      "drive": "wait",
      "selector": "[data-testid=\"settings-tab-profile\"]",
      "timeoutMs": 15000
    },
    {
      "id": "open-profile-tab-again",
      "drive": "click",
      "selector": "[data-testid=\"settings-tab-profile\"]"
    },
    {
      "id": "wait-reset",
      "drive": "wait",
      "selector": "[data-testid=\"profile-reset\"]",
      "timeoutMs": 15000
    },
    {
      "id": "use-detected",
      "drive": "click",
      "selector": "[data-testid=\"profile-reset\"]"
    },
    {
      "id": "reset-confirmed",
      "expectText": "Using the detected identity.",
      "timeoutMs": 15000
    },
    {
      "id": "detected-identity-restored",
      "drive": "evaluate",
      "expression": "(function(){var c=document.querySelector('[data-testid=\"profile-current\"]');return c?c.textContent:'no-card';})()",
      "expectContains": "Drill Env <env@drill.test>"
    },
    {
      "id": "capture-evidence",
      "drive": "screenshot",
      "output": "target/auditaur-identity-drill.png"
    },
    {
      "id": "no-reload-fallback",
      "forbidText": ["Something went wrong", "Reload interface"]
    },
    {
      "id": "frontend-errors",
      "telemetry": "errors",
      "maxCount": 0
    },
    {
      "id": "failed-ipc",
      "telemetry": "failed-ipc",
      "maxCount": 0
    },
    {
      "id": "identity-commands-not-in-ipc-telemetry",
      "trace": "ipc",
      "notContains": ["contributor_identity"],
      "timeoutMs": 5000
    },
    {
      "id": "email-not-in-logs",
      "trace": "logs",
      "notContains": ["profile@drill.test"],
      "timeoutMs": 5000
    },
    {
      "id": "email-not-in-traces",
      "trace": "traces",
      "notContains": ["profile@drill.test"],
      "timeoutMs": 5000
    },
    {
      "id": "explain",
      "telemetry": "explain"
    }
  ]
}
