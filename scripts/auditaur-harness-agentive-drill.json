{
  "app": "cutready",
  "label": "harness-agentive",
  "timeoutSeconds": 240,
  "globalSettings": {
    "seed": {
      "aiAgentExecutionEngine": "prompty"
    }
  },
  "fixture": {
    "prefix": "cutready-harness-agentive-drill-",
    "sketches": [
      {
        "path": "intro.sk",
        "title": "Agentive Harness Drill Fixture",
        "narrative": "A sketch so the app opens into the full workspace shell."
      }
    ]
  },
  "steps": [
    {
      "id": "wait-for-shell",
      "drive": "wait",
      "selector": "[data-testid=\"activity-settings\"]",
      "timeoutMs": 45000
    },
    {
      "id": "open-settings",
      "drive": "click",
      "selector": "[data-testid=\"activity-settings\"]"
    },
    {
      "id": "wait-ai-tab",
      "drive": "wait",
      "selector": "[data-testid=\"settings-tab-ai\"]",
      "timeoutMs": 15000
    },
    {
      "id": "open-ai-section",
      "drive": "click",
      "selector": "[data-testid=\"settings-tab-ai\"]"
    },
    {
      "id": "wait-agent-subtab",
      "drive": "wait",
      "selector": "[data-testid=\"settings-ai-tab-agent\"]",
      "timeoutMs": 15000
    },
    {
      "id": "open-agent-subtab",
      "drive": "click",
      "selector": "[data-testid=\"settings-ai-tab-agent\"]"
    },
    {
      "id": "wait-harness-picker",
      "drive": "wait",
      "selector": "[data-testid=\"harness-picker\"]",
      "timeoutMs": 15000
    },
    {
      "id": "prompty-selected-at-start",
      "drive": "wait",
      "selector": "[data-testid=\"harness-option-prompty\"][data-selected=\"true\"]",
      "timeoutMs": 10000
    },
    {
      "id": "agentive-card-available",
      "drive": "evaluate",
      "expression": "(function(){var c=document.querySelector('[data-testid=\"harness-option-agentive\"]');if(!c)return 'no-agentive-card';if(c.tagName==='BUTTON'&&c.disabled)return 'agentive-unavailable';var b=c.querySelector('button');if(b&&b.disabled)return 'agentive-unavailable';return 'ok';})()",
      "expectValue": "ok"
    },
    {
      "id": "click-agentive-card",
      "drive": "click",
      "selector": "[data-testid=\"harness-option-agentive\"]"
    },
    {
      "id": "agentive-now-selected",
      "drive": "wait",
      "selector": "[data-testid=\"harness-option-agentive\"][data-selected=\"true\"]",
      "timeoutMs": 10000
    },
    {
      "id": "no-unavailable-warning",
      "drive": "evaluate",
      "expression": "(function(){return document.querySelector('[data-testid=\"harness-unavailable-warning\"]')?'warning-shown':'clean';})()",
      "expectValue": "clean"
    },
    {
      "id": "capture-evidence",
      "drive": "screenshot",
      "output": "target/auditaur-harness-agentive-drill.png"
    },
    {
      "id": "no-reload-fallback",
      "forbidText": ["Something went wrong", "Reload interface"]
    },
    {
      "id": "frontend-errors",
      "telemetry": "errors",
      "maxCount": 0
    },
    {
      "id": "failed-ipc",
      "telemetry": "failed-ipc",
      "maxCount": 0
    },
    {
      "id": "explain",
      "telemetry": "explain"
    },
    {
      "id": "close-settings",
      "drive": "click",
      "selector": "[data-testid=\"settings-close\"]"
    },
    {
      "id": "reveal-chat",
      "drive": "click",
      "selector": "[data-testid=\"activity-chat\"]"
    },
    {
      "id": "wait-composer",
      "drive": "wait",
      "selector": "textarea[placeholder^=\"Ask about your demo plan\"]",
      "timeoutMs": 20000
    },
    {
      "id": "focus-composer",
      "drive": "click",
      "selector": "textarea[placeholder^=\"Ask about your demo plan\"]"
    },
    {
      "id": "type-prompt",
      "drive": "fill",
      "selector": "textarea[placeholder^=\"Ask about your demo plan\"]",
      "value": "Reply with the single word READY and nothing else."
    },
    {
      "id": "send-turn",
      "drive": "click",
      "selector": "button[title=\"Send (Enter)\"]"
    },
    {
      "id": "agentive-harness-executes-turn",
      "trace": "logs",
      "contains": ["agent_chat_with_tools_start", "\"execution_engine\":\"agentive\""],
      "notContains": ["agent_chat_with_tools_start", "\"execution_engine\":\"prompty\""],
      "timeoutMs": 60000
    }
  ]
}
